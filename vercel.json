{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun install --frozen-lockfile && bun run --filter @wf/frontend build",
  "installCommand": "echo skip",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "functions": {
    "frontend/app/api/sessions/[id]/stream/route.ts": {
      "maxDuration": 300
    }
  }
}
